<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded pill button for the Restart head unit action -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/carplay_button_background_pressed" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/carplay_button_background" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
