+    /**
+     * How long (ms) to pause Bluetooth re-dialing after a Wi-Fi handoff, so the
+     * single BT radio stays free for the A2DP audio workaround while CarPlay runs
+     * over Wi-Fi.  persist.cpbridge.session_quiet_ms; default 120000 (2 min).
+     * Set 0 to restore the original continuous 5 s re-dial.  Trade-off: if a
+     * handoff silently failed, automatic retry is delayed by up to this long.
+     */
+    static long sessionQuietMs() {
+        String v = getProp("persist.cpbridge.session_quiet_ms", null);
+        if (v != null && v.length() > 0) {
+            try {
+                long ms = Long.parseLong(v.trim());
+                if (ms >= 0) {
+                    return ms;
+                }
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return 120000L;
+    }
