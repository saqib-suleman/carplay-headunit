<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:paddingTop="16dp" android:paddingBottom="16dp"
        android:paddingLeft="16dp" android:paddingRight="16dp">
        <ImageView android:layout_width="56dp" android:layout_height="56dp"
            android:src="@drawable/ic_restart" android:tint="@color/accent"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/title"
            android:textColor="@color/title" android:textSize="24sp" android:fontFamily="sans-serif-light"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/subtitle"
            android:textColor="@color/subtitle" android:textSize="13sp" android:gravity="center"/>
        <Button android:id="@+id/restart_button"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:paddingLeft="48dp" android:paddingRight="48dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:text="@string/restart" android:textColor="#FF000000" android:textSize="17sp"
            android:textAllCaps="false" android:background="@drawable/button_bg"
            android:stateListAnimator="@null"/>
        <Button android:id="@+id/wl_toggle_button"
            android:layout_width="340dp" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:text="@string/wl_toggle" android:textColor="#FF000000" android:textSize="16sp"
            android:textAllCaps="false" android:background="@drawable/button_bg"
            android:stateListAnimator="@null"/>
        <Button android:id="@+id/hs_toggle_button"
            android:layout_width="340dp" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:text="@string/hs_toggle" android:textColor="#FF000000" android:textSize="16sp"
            android:textAllCaps="false" android:background="@drawable/button_bg"
            android:stateListAnimator="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/call_status"
            android:textColor="@color/subtitle" android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
